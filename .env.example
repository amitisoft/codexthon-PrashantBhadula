# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Backend
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=personal_finance_tracker;Username=finance_user;Password=finance_password
Jwt__Issuer=personal-finance-tracker
Jwt__Audience=personal-finance-tracker-client
Jwt__Key=replace-with-a-long-random-secret
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14
App__FrontendBaseUrl=http://localhost:5173
Resend__ApiKey=re_replace_me
Resend__FromEmail=no-reply@example.com
Resend__FromName=Personal Finance Tracker

# Local infrastructure
POSTGRES_DB=personal_finance_tracker
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_password
